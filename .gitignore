# --- Ansible / credenciales ---
# Contraseñas y secretos en texto plano (ajusta nombres si aplica)
*password*
*passwd*
*secret*
secrets.yml
secrets.yaml
vault.yml
vault.yaml
*vault*
*.vault
.vault_pass
.vault-pass
.env
.env.*

# Claves privadas SSH / TLS
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
*.pub
!*.pub.example
ssh_keys/
keys/

# --- Ansible artefactos ---
*.retry
*.log
.ansible/
ansible.log

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*$py.class
.venv/
venv/
env/
ENV/
.conda/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- Sistema / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# NOTA: respaldos/ NO se ignora por defecto para que la evidencia sea auditable.
# Si tus running-config contienen enable secret / passwords, descomenta:
# respaldos/
# evidencias/*.log
